{
  "name": "impactwave",
  "version": "1.2.0",
  "main": "./dist/cli.js",
  "type": "module",
  "bin": {
    "impactwave": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck:test": "tsc -p test/tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "golden:update": "UPDATE_GOLDEN=1 tsx --test test/report-golden.test.ts"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "impact analysis",
    "blast radius",
    "code impact",
    "dependency analysis",
    "code analysis",
    "static analysis",
    "typescript",
    "javascript",
    "node",
    "cli",
    "developer tools",
    "git",
    "testing"
  ],
  "author": "paleto30",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paleto30/impactwave.git"
  },
  "homepage": "https://github.com/paleto30/impactwave#readme",
  "bugs": {
    "url": "https://github.com/paleto30/impactwave/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "ISC",
  "description": "Blast radius analyzer CLI for TypeScript and JavaScript: find which exported symbols your Git changes modify, who consumes them, what tests cover them, and get a deterministic risk score before merging.",
  "dependencies": {
    "commander": "^15.0.0",
    "simple-git": "^3.36.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
